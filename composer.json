{
    "name": "atwx/silverstripe-frontdesk-demo",
    "type": "project",
    "description": "Public feature demo of atwx/silverstripe-frontdesk-kit: every feature live, with the code that builds it.",
    "authors": [
        {
            "name": "Andy Adiwidjaja",
            "email": "adiwidjaja@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-core": "^6.2",
        "silverstripe/admin": "^3.2",
        "silverstripe/asset-admin": "^3.2",
        "silverstripe/siteconfig": "^6.2",
        "ext-intl": "*",
        "ext-json": "*",
        "atwx/silverstripe-vitehelper": "^1.6",
        "atwx/silverstripe-frontdesk-kit": "dev-main",
        "atwx/silverstripe-projectinfo": "^1.2",
        "silverstripe/mimevalidator": "^4"
    },
    "require-dev": {
        "silverleague/ideannotator": "^4.0",
        "wernerkrauss/silverstripe-rector": "^1",
        "cambis/silverstan": "^2",
        "squizlabs/php_codesniffer": "^3",
        "phpstan/extension-installer": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "vendor/bin/phpcs",
        "fix": "vendor/bin/phpcbf",
        "rector": "vendor/bin/rector -v",
        "rector-dry": "vendor/bin/rector -v --dry-run",
        "phpstan": "vendor/bin/phpstan"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "expose": [
            "app/client/dist"
        ],
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    }
}
